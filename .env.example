BOT_TOKEN=123456789:AAExampleTokenFromBotFather
GROUP_CHAT_ID=-1001234567890
DOWNLOAD_DIR=photos/incoming
DB_PATH=data/bot.db

# stub — ничего не печатает, только логирует (по умолчанию, для разработки)
# cups — реальная печать через системную очередь CUPS (например, Canon SELPHY)
PRINTER_BACKEND=stub

# Имя очереди в CUPS, см. `lpstat -p` (нужно только при PRINTER_BACKEND=cups)
PRINTER_NAME=

# Доп. опции для `lp -o ...` через запятую, см. `lpoptions -l -p <PRINTER_NAME>`
# Например: media=Postcard,fit-to-page
PRINTER_OPTIONS=
